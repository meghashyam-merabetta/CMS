# Copy this file to .env.local and fill in the values.

# Direct backend API URL
 NEXT_PUBLIC_API_URL=http://localhost:3000



# Dev-only password for the "Admin" quick-fill card on /login. Ask the backend team.
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
# Enable only after migration 038 and the variant-image API/cleanup workers are deployed.
NEXT_PUBLIC_VARIANT_IMAGES_ENABLED=false
